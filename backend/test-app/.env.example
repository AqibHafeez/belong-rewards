PORT=3000
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=belong
DB_PASSWORD=belong_dev
DB_DATABASE=fan_rewards
DB_POOL_SIZE=10
DB_POOL_MIN=2

JWT_ACCESS_SECRET=change-me-to-a-secure-random-string
JWT_REFRESH_SECRET=change-me-to-another-secure-random-string
# Token expiry (default: 15m access, 7d refresh)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Auth tuning (defaults shown)
BCRYPT_ROUNDS=12
MAX_FAILED_ATTEMPTS=5
LOCK_DURATION_MS=900000

REDIS_URL=redis://localhost:6379

# Rate limiting (defaults shown)
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_WINDOW=1 minute

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Secret key for admin endpoints (X-Admin-Key header)
ADMIN_API_KEY=change-me-to-a-secure-admin-key
